{
  "manifestVersion": 5,
  "id": "com.parter.subtitles",
  "name": "Parter Subtitles",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "parterSubtitlesPanel",
      "label": {
        "default": "Parter Subtitles"
      },
      "minimumSize": {
        "width": 300,
        "height": 500
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": []
    }
  }
}
