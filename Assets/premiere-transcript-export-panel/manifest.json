{
  "manifestVersion": 5,
  "id": "com.parter.transcript-export-panel",
  "name": "Parter Transcript Export",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "transcriptExportPanel",
      "label": {
        "default": "Transcript Export"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
